PORT=4000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=jobhunt
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/jobhunt
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_super_secret_jwt_key_change_this
GOOGLE_CLIENT_ID=your_google_client_id
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_this

# SMTP Configuration (Required for verification & reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=noreply@jobhunt.com
